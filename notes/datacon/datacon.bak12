<TD ALIGN=CENTER><B>Height</B>&nbsp;</TD>

<TD ALIGN=CENTER><B>Minimum Lot Size</B>&nbsp;</TD>

<TD ALIGN=CENTER><B>Maximum Number of Dwelling Units</B>&nbsp;</TD>
</TR>

<TR>
